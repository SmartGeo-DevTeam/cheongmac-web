generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id
  name                  String
  email                 String    @unique
  emailVerified         Boolean   @default(false)
  image                 String?
  phone                 String?
  role                  String    @default("MEMBER")
  membershipStatus      String    @default("PENDING")
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions         Session[]
  accounts         Account[]
  consents         Consent[]
  loginLogs        UserLoginLog[]
  activitySessions UserActivitySession[]
  pageViews        UserPageView[]
  activityEvents   UserActivityEvent[]
  contentRevisions ContentRevision[]     @relation("ContentRevisionEditor")
  auditLogs        AdminAuditLog[]       @relation("AuditActor")

  @@index([membershipStatus])
  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Consent {
  id         String   @id @default(cuid())
  userId     String
  type       String
  version    String
  acceptedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, version])
  @@index([userId])
  @@map("consent")
}

model UserLoginLog {
  id            String   @id @default(cuid())
  userId        String
  authSessionId String   @unique
  provider      String?
  deviceType    String?
  userAgent     String?  @db.Text
  loggedInAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedInAt])
  @@map("user_login_log")
}

model UserActivitySession {
  id             String    @id
  userId         String
  authSessionId  String
  startedAt      DateTime  @default(now())
  lastActiveAt   DateTime  @default(now())
  endedAt        DateTime?
  pageViewCount  Int       @default(0)
  engagedSeconds Int       @default(0)
  entryPath      String?
  exitPath       String?
  deviceType     String?
  userAgent      String?   @db.Text

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageViews UserPageView[]
  events    UserActivityEvent[]

  @@index([userId, startedAt])
  @@index([authSessionId])
  @@map("user_activity_session")
}

model UserPageView {
  id                String    @id
  userId            String
  activitySessionId String
  path              String
  pageTitle         String?
  referrerPath      String?
  nextPath          String?
  enteredAt         DateTime  @default(now())
  leftAt            DateTime?
  engagedSeconds    Int       @default(0)

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activitySession UserActivitySession @relation(fields: [activitySessionId], references: [id], onDelete: Cascade)
  events          UserActivityEvent[]

  @@index([userId, enteredAt])
  @@index([activitySessionId, enteredAt])
  @@index([path])
  @@map("user_page_view")
}

model UserActivityEvent {
  id                String   @id @default(cuid())
  userId            String
  activitySessionId String
  pageViewId        String?
  eventType         String
  path              String
  targetId          String?
  metadata          Json?
  createdAt         DateTime @default(now())

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activitySession UserActivitySession @relation(fields: [activitySessionId], references: [id], onDelete: Cascade)
  pageView        UserPageView?       @relation(fields: [pageViewId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([activitySessionId, createdAt])
  @@index([eventType, createdAt])
  @@index([path])
  @@map("user_activity_event")
}

model Content {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions ContentRevision[]

  @@map("content")
}

model ContentRevision {
  id        String   @id @default(cuid())
  contentId String
  oldValue  String   @db.Text
  newValue  String   @db.Text
  version   Int
  editorId  String
  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  editor  User    @relation("ContentRevisionEditor", fields: [editorId], references: [id], onDelete: Restrict)

  @@index([contentId, createdAt])
  @@index([editorId])
  @@map("content_revision")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_log")
}

model NavigationMenu {
  id        String   @id
  parentId  String?
  title     String
  href      String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   NavigationMenu?  @relation("NavigationTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NavigationMenu[] @relation("NavigationTree")

  @@index([parentId, sortOrder])
  @@map("navigation_menu")
}
