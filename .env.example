# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Supabase PostgreSQL
# Runtime: Supavisor Transaction Pooler (recommended for serverless, usually port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Prisma CLI / migrations: Direct connection or Supavisor Session Pooler (usually port 5432)
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Storage - 사용자 폼 첨부파일 (비공개)
# SERVICE_ROLE_KEY는 서버 전용 비밀키입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_FORM_ATTACHMENTS_BUCKET=form-attachments

# Azure Blob Storage - 공개 홈페이지 에셋 / 관리자 이미지 업로드
# AZURE_STORAGE_CONNECTION_STRING은 서버 전용 비밀값입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=cheongmacmedia;AccountKey=your-account-key;EndpointSuffix=core.windows.net
AZURE_STORAGE_PUBLIC_CONTAINER=assets
NEXT_PUBLIC_AZURE_ASSET_BASE_URL=https://cheongmacmedia.blob.core.windows.net/assets

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
